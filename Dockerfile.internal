FROM python:3.8-slim

ENV PYTHONDONTWRITEBYTECODE=1

ENV PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN python -m pip install -r requirements.txt

COPY internal /internal
COPY config.ini /internal/

RUN adduser -u 5678 --disabled-password --gecos "" appuser && chown -R appuser /internal
USER appuser

WORKDIR /internal
CMD ["python", "internal.py", "config.ini"]
