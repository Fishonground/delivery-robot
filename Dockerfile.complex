FROM python:3.8-slim

ENV PYTHONDONTWRITEBYTECODE=1

ENV PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN python -m pip install -r requirements.txt

COPY complex /complex
COPY config.ini /complex/

RUN adduser -u 5678 --disabled-password --gecos "" appuser && chown -R appuser /complex
USER appuser

WORKDIR /complex
CMD ["python", "complex.py", "config.ini"]
